	"vars": {
		"LLM_MODEL": "openai/gpt-oss-120b",
		"VERBOSE": "true",
		// "LLM_MODEL": "gemini-2.5-flash",
		// "LLM_MODEL": "llama-3.3-70b-versatile",

		"CF_ACCOUNT_ID": "ec758d282b2c89b4a1a147b64f445849",
		"CF_GATEWAY_NAME": "testing-gateway-2",
		"CF_AIG_TOKEN": "O2bUj1gkZwFjlrW4HnXz_d1tMxWbbT8UMBJFfHqA",
		"WA_VERIFY_TOKEN": "verificationtesting123",
		"WA_PHONE_NUMBER_ID": "987003544491839",
		"GEMINI_API_KEY": "",
		"OPENAI_API_KEY": "",
		"GROQ_API_KEY": "",
		"WA_ACCESS_TOKEN": ""
	},

	"kv_namespaces": [
		{
			"binding": "KV_NAMESPACE",
			"id": "f5ec253a6a79442e87838fd8cea5aaeb"
		}
	],

	 "ai": {
    "binding": "AI" // i.e. available in your Worker on env.AI
  },
}